# Vite reenvía las solicitudes /api al backend local.
# Debe coincidir con FINANCIERA_V2_PORT o PORT del backend.
VITE_API_PROXY_TARGET=http://localhost:8082

# En producción (Vercel), usa la URL pública del backend en Render, sin /api al final.
# Ejemplo: https://financiera-v2-backend.onrender.com
# Déjalo vacío en local para usar el proxy de Vite.
VITE_API_BASE_URL=
