# Copia como .env en esta carpeta y completa los valores desde Supabase.
# Para Render, registra estas claves en Environment; no subas el archivo .env.
# Usa el Session pooler de Supabase (IPv4) y su usuario postgres.<PROJECT_REF>.
# Si usas la conexión directa db.<PROJECT_REF>.supabase.co, cambia el usuario a postgres.
FINANCIERA_V2_DATABASE_URL=jdbc:postgresql://<POOLER_HOST>:5432/postgres?sslmode=require
FINANCIERA_V2_DATABASE_USERNAME=postgres.<PROJECT_REF>
FINANCIERA_V2_DATABASE_PASSWORD=replace-with-supabase-database-password
FINANCIERA_V2_DATABASE_POOL_SIZE=5

# Puerto local; Render asigna PORT automáticamente.
FINANCIERA_V2_PORT=8082

# Opcional: solo necesario si se habilita el sembrado inicial.
FINANCIERA_V2_ADMIN_USERNAME=gerente
FINANCIERA_V2_ADMIN_PASSWORD=replace-with-a-strong-unique-password
FINANCIERA_V2_SEED_PASSWORD=replace-with-another-strong-unique-password
APP_SEED_ENABLED=false

# Opcional: búsquedas de DNI.
DNI_API_KEY=
